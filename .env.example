# OmniHost server settings. Copy to your host's environment variables (Railway → Variables).
# Nothing here is required for local use — START_HOSTING.bat works without any of it.

# Port the panel listens on. Railway/Render set this automatically.
PORT=3000

# 127.0.0.1 = only this computer (local default). 0.0.0.0 = public (production default).
# HOST=0.0.0.0

# Set to "production" when hosting publicly (the Docker image already does).
# NODE_ENV=production

# Where services, the database, logs and backups are stored. Point this at a persistent volume.
# Default: the project folder locally, /data in Docker.
# DATA_DIR=/data

# Long random string. If unset, one is generated and stored in DATA_DIR/.omnihost/secret.key.
# SESSION_SECRET=

# Public address of the panel (used for links shown in the UI), e.g. https://omnihost.up.railway.app
# PUBLIC_URL=

# Optional: enables the "Ask AI" crash assistant. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=
# OMNI_AI_MODEL=claude-opus-5-5

# First internal port handed to web apps (they are reached through /apps/<id>/).
# APP_PORT_START=4100

# Upload size limit per file, in MB.
# MAX_UPLOAD_MB=100
